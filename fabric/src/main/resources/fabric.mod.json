{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "ImBanana"
    ],
    "contact": {
        "homepage": "https://modrinth.com/project/${modrinth_id}"
    },
    "license": "${mod_license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "me.imbanana.vanillawaypoints.fabric.VanillaWaypointsFabric"
        ],
        "client": [
            "me.imbanana.vanillawaypoints.fabric.VanillaWaypointsClientFabric"
        ],
        "modmenu": [
            "me.imbanana.vanillawaypoints.fabric.ModMenuEntry"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": "${loader_version_range}",
        "minecraft": "${mc_version_range}",
        "java": ">=${java_version}",
        "yet_another_config_lib_v3": ">=${yacl_version}",
        "fabric-api": "*"
    },
    "custom": {
        "modmenu": {
        }
    }
}
