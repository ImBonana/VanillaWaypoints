{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "ImBanana"
    ],
    "contact": {
        "homepage": "https://modrinth.com/project/${modrinth_id}"
    },
    "license": "${mod_license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "me.imbanana.modtemplate.fabric.ModtemplateFabric"
        ],
        "client": [
            "me.imbanana.modtemplate.fabric.client.ModtemplateFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": "${loader_version_range}",
        "minecraft": "${mc_version_range}",
        "java": ">=${java_version}",
        "fabric-api": "*"
    }
}
